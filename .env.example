# ─── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@db:5432/ivr_voice

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Storage (MinIO in dev — remove AWS_S3_ENDPOINT_URL for real S3) ────────
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=ivr-audio
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# ─── TTS — Chatterbox (MIT, no API key, self-hosted on RTX 5060) ────────────
TTS_PROVIDER=chatterbox
TTS_MODEL=original
TTS_DEVICE=cuda

# ─── Audio output (IVR codec — adjust per client PBX vendor) ────────────────
FFMPEG_SAMPLE_RATE=8000
FFMPEG_OUTPUT_FORMAT=wav
FFMPEG_AUDIO_CODEC=pcm_s16le

# ─── FastAPI (generation service) ────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# ─── Frontend (Vite — Ahtesham owns these) ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_FASTAPI_BASE_URL=http://localhost:8001
VITE_USE_MOCK_API=true
VITE_MOCK_FAIL_GENERATION=false
EOF

BRAND_NAMES_PATH=/app/config/brand_names.json